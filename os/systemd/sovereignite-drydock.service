[Unit]
Description=Sovereignite Kubernetes bootstrap service
Requires=sovereignite-armory.service sovereignite-admiralty.service
After=sovereignite-armory.service sovereignite-admiralty.service containerd.service
Wants=containerd.service

[Service]
Type=simple
User=root
Group=root
UMask=0077
RuntimeDirectory=sovereignite/bootstrap
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=no
ExecStartPre=/usr/bin/test -x /usr/bin/sovereignite-drydock
ExecStart=/usr/bin/sovereignite-drydock
ExecStartPost=/opt/sovereignite/bin/sovereignite-wait-ready bootstrap-prepared /run/sovereignite/bootstrap/prepared.json 120
TimeoutStartSec=135s
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/etc/kubernetes /run/sovereignite/bootstrap
ReadWritePaths=/var/lib/sovereignite/bootstrap /var/lib/kubelet
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=sovereignite-pre-kubernetes.target
